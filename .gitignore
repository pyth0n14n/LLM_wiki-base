# LLM Wiki - Untracked Files

# Raw sources are the source of truth. Keep text sources versioned, but exclude
# large binaries and local captures by default.
raw/assets/
raw/**/*.pdf
raw/**/*.epub
raw/**/*.mobi
raw/**/*.mp3
raw/**/*.mp4
raw/**/*.mov
raw/**/*.avi
raw/**/*.zip
raw/**/*.7z

# System files
.DS_Store
*.swp
*.swo
*~
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
env/
ENV/

# Node
node_modules/
package-lock.json
npm-debug.log

# IDE
.idea/
*.sublime-workspace

# OS-specific
.env.local
.env.*.local

# Temporary files
*.tmp
*.log
